---
const { title = "Cuts &\nStyling", items = [] } = Astro.props;
---

<section class="w-full px-6 md:px-45 py-20 md:py-32">
    <!-- Section Title -->
    <h2
        class="font-display text-[4rem] md:text-[6rem] lg:text-[4rem] font-bold uppercase leading-[0.9] tracking-tight text-[#1a0910] mb-20 md:mb-18"
    >
        {
            title.split("\n").map((line, i, arr) => (
                <>
                    {line}
                    {i < arr.length - 1 && <br />}
                </>
            ))
        }
    </h2>

    <!-- Price List Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24">
        {
            items.map((item) => (
                <div class="flex items-center justify-between border-b border-[#1a0910]/40 py-5 md:py-4">
                    <span class="text-sm md:text-base uppercase tracking-wide text-[#1a0910] font-medium">
                        {item.name}
                    </span>
                    <span class="text-sm md:text-base text-[#1a0910] font-medium tabular-nums">
                        €{item.price}
                    </span>
                </div>
            ))
        }
    </div>
</section>
