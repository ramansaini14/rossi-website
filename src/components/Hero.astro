---
import { site, ticker, works } from "../data/site.js";
import BookNowButton from "./BookNowButton.astro";
import ReachOut from "./ReachOut.astro";
import Expect from "./Expect.astro";

import heroImage from "../assets/hero.jpg";
import heroImage1 from "../assets/hero1.jpg";
import heroImage2 from "../assets/hero2.jpg";
import heroImage3 from "../assets/hero3.jpg";
import heroImage4 from "../assets/hero4.jpg";
import heroImage5 from "../assets/hero5.jpg";
import mywork1 from "../assets/mywork1.jpg";
import mywork2 from "../assets/mywork2.jpg";
import mywork3 from "../assets/mywork3.jpg";
import mywork4 from "../assets/mywork4.jpg";
import mywork5 from "../assets/mywork5.jpg";
import mywork6 from "../assets/mywork6.jpg";
import mywork7 from "../assets/mywork7.jpg";
import mywork8 from "../assets/mywork8.jpg";
import mywork9 from "../assets/mywork9.jpg";
import mywork10 from "../assets/mywork10.jpg";
import mywork11 from "../assets/mywork11.jpg";
import mywork12 from "../assets/mywork12.jpg";
import spacer from "../assets/spacer.jpg";
---

<!-- <div
    class="relative flex flex-col items-center justify-center overflow-hidden bg-paper text-ink"
>
    <h1
        class="font-display text-5xl font-bold uppercase tracking-display md:text-[26rem]"
    >
        {site.name}
    </h1>
</div> -->
<div
    class="relative flex w-full items-center justify-center overflow-hidden bg-paper text-ink flex-col"
>
    <!-- Role -->
    <div class="absolute left-6 top-8 uppercase">
        <p class="text-[10px] leading-3">Role</p>
        <p class="text-[13px] leading-4">Stylist</p>
    </div>

    <!-- Experience -->
    <div class="absolute right-6 top-8 text-right uppercase">
        <p class="text-[10px] leading-3">Experience</p>
        <p class="text-[13px] leading-4">10+ Years</p>
    </div>

    <!-- Name -->
    <h1 class="font-display text-[26rem] text-5xl font-bold uppercase">
        {site.name}
    </h1>

    <!-- Expertise -->
    <div class="absolute bottom-8 left-6 uppercase">
        <p class="text-[10px] leading-3">Expertise</p>
        <p class="text-[13px] leading-4">Hair & Color</p>
    </div>

    <!-- Location -->
    <div class="absolute bottom-8 right-6 text-right uppercase">
        <p class="text-[10px] leading-3">Location</p>
        <p class="text-[13px] leading-4">Milan, Italy</p>
    </div>
</div>
<div class="w-full overflow-hidden border-y border-ink py-4">
    <div
        class="flex w-max animate-[ticker_30s_linear_infinite] items-center whitespace-nowrap"
    >
        {
            /* 1. Duplicate the array 4 times to guarantee it fills the screen */
            [...ticker, ...ticker].map((item, index) => (
                <div key={index} class="flex items-center">
                    <span class="text-sm uppercase">{item}</span>
                    <div
                        class="framer-v100r8 mx-4 h-[1px] w-15 bg-ink"
                        data-framer-name="Divider"
                    />
                </div>
            ))
        }
    </div>
</div>
<div class="pt-[18px] px-[18px]">
    <div
        class="relative w-full mx-auto aspect-[8/8] overflow-hidden rounded-sm shadow-2xl bg-gray-200"
    >
        <!-- 1. Base Image -->
        <img
            src={heroImage.src}
            alt="Main Portrait"
            class="absolute inset-0 w-full h-full object-cover"
        />

        <!-- 2. Grid Overlay (8x8 grid, 5px lines) -->
        <div
            class="absolute inset-0 z-10 pointer-events-none
                bg-[linear-gradient(to_right,rgba(255,255,255,0.8)_3px,transparent_3px),linear-gradient(to_bottom,rgba(255,255,255,0.8)_3px,transparent_3px)]
                bg-[size:calc(100%/8)_calc(100%/8)]"
        >
        </div>

        <!-- 3. Cutout Images (Aligned to 8x8 Grid) -->

        <!-- Cutout 1: (Row 2, Col 3) -->
        <!-- top: (2-1)*12.5% = 12.5% | left: (3-1)*12.5% = 25% -->
        <div
            class="absolute top-[12.5%] left-[25%] w-[12.5%] h-[12.5%] z-20 cutout overflow-hidden pt-[3px] pl-[3px] bg-white"
        >
            <img
                src={heroImage1.src}
                alt="Cutout 1"
                class="w-full h-full object-cover"
            />
            <!-- Overlay -->
            <div
                class="absolute inset-0 bg-[#f05497] opacity-96 mix-blend-multiply mt-[3px] ml-[3px]"
            >
            </div>
        </div>

        <!-- Cutout 2: (Row 3, Col 8) -->
        <!-- top: (3-1)*12.5% = 25% | left: (8-1)*12.5% = 87.5% -->
        <div
            class="absolute top-[25%] left-[87.5%] w-[12.5%] h-[12.5%] z-20 cutout overflow-hidden pt-[3px] pl-[3px] bg-white"
        >
            <img
                src={heroImage2.src}
                alt="Cutout 2"
                class="w-full h-full object-cover"
            />
            <!-- Overlay -->
            <div
                class="absolute inset-0 bg-[#f05497] opacity-96 mix-blend-multiply mt-[3px] ml-[3px]"
            >
            </div>
        </div>

        <!-- Cutout 3: (Row 4, Col 5) -->
        <!-- top: (4-1)*12.5% = 37.5% | left: (5-1)*12.5% = 50% -->
        <div
            class="absolute top-[37.5%] left-[50%] w-[12.5%] h-[12.5%] z-20 cutout overflow-hidden pt-[3px] pl-[3px] bg-white"
        >
            <img
                src={heroImage3.src}
                alt="Cutout 3"
                class="w-full h-full object-cover"
            />
            <!-- Overlay -->
            <div
                class="absolute inset-0 bg-[#f05497] opacity-96 mix-blend-multiply mt-[3px] ml-[3px]"
            >
            </div>
        </div>

        <!-- Cutout 4: (Row 6, Col 2) -->
        <!-- top: (6-1)*12.5% = 62.5% | left: (2-1)*12.5% = 12.5% -->
        <div
            class="absolute top-[62.5%] left-[12.5%] w-[12.5%] h-[12.5%] z-20 cutout overflow-hidden pt-[3px] pl-[3px] bg-white"
        >
            <img
                src={heroImage4.src}
                alt="Cutout 4"
                class="w-full h-full object-cover"
            />
            <!-- Overlay -->
            <div
                class="absolute inset-0 bg-[#f05497] opacity-96 mix-blend-multiply mt-[3px] ml-[3px]"
            >
            </div>
        </div>

        <!-- Cutout 5: (Row 7, Col 7) -->
        <!-- top: (7-1)*12.5% = 75% | left: (7-1)*12.5% = 75% -->
        <div
            class="absolute top-[75%] left-[75%] w-[12.5%] h-[12.5%] z-20 cutout overflow-hidden pt-[3px] pl-[3px] bg-white"
        >
            <img
                src={heroImage5.src}
                alt="Cutout 5"
                class="w-full h-full object-cover"
            />
            <!-- Overlay -->
            <div
                class="absolute inset-0 bg-[#f05497] opacity-96 mix-blend-multiply mt-[3px] ml-[3px]"
            >
            </div>
        </div>
    </div>
</div>
<div class="pt-[4px] px-[18px]">
    <BookNowButton />
</div>
<div
    class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-paper text-ink"
>
    <!-- Top Left -->
    <div class="absolute left-6 top-8 uppercase md:left-[9.5%] md:top-12">
        <p class="text-[10px] leading-3">Experienced</p>
        <p class="text-[13px] leading-4">Hair Stylist</p>
    </div>

    <!-- Main Heading -->
    <h1
        class="w-full px-6 text-center font-display text-[5rem] font-bold uppercase leading-[0.92] tracking-[-0.04em] sm:text-[4.5rem] md:max-w-[850px] md:px-0 md:text-[5.5rem]"
    >
        Independent<br />
        Stylist in Milan,<br />
        Creating Clean,<br />
        Modern Hair
    </h1>

    <!-- Bottom Left -->
    <div class="absolute bottom-8 left-6 uppercase md:bottom-12 md:left-6">
        <p class="text-[10px] leading-3">Focused on</p>
        <p class="text-[13px] leading-4">Longevity</p>
    </div>

    <!-- Bottom Right -->
    <div
        class="absolute bottom-8 right-6 max-w-[220px] text-left md:bottom-12 md:right-[9.5%]"
    >
        <p class="text-[14px] leading-[1.35]">
            I shape hair with precision,<br />
            balance, and long-term focus.
        </p>

        <a
            href="#"
            class="mt-4 inline-flex items-center gap-2 border-b border-ink pb-1 text-[11px] uppercase"
        >
            Learn More
            <span class="text-[14px]">→</span>
        </a>
    </div>
</div>
<div class="min-h-screen py-16 px-6">
    <!-- Header -->
    <div class="text-center mb-16">
        <p
            class="font-script text-[30px] tracking-normal uppercase text-[#f05497]"
        >
            Latest
        </p>
        <h1 class="font-display text-4xl md:text-6xl uppercase">My Work</h1>
    </div>

    <!-- Grid Container -->
    <div class="mx-auto grid grid-cols-12 gap-x-6 gap-y-8 md:gap-y-0">
        {
            works.map((work, i) => {
                // Position + aspect ratio per item
                const positions = [
                    "col-span-12 md:col-span-3 md:col-start-1 md:mt-0", // 0 – large portrait
                    "col-span-12 md:col-span-2 md:col-start-7 md:mt-0", // 1 – small portrait
                    "col-span-12 md:col-span-3 md:col-start-10 md:mt-40", // 2 – square
                    "col-span-12 md:col-span-2 md:col-start-1 md:mt-48", // 3 – small square
                    "col-span-12 md:col-span-3 md:col-start-5 md:mt-8", // 4 – landscape
                    "col-span-12 md:col-span-2 md:col-start-9 md:mt-48", // 5 – small portrait
                    "col-span-12 md:col-span-3 md:col-start-2 md:mt-6", // 6 – large portrait
                    "col-span-12 md:col-span-3 md:col-start-7 md:mt-46", // 7 – large portrait
                    "col-span-12 md:col-span-2 md:col-start-11 md:mt-46", // 8 – small square
                    "col-span-12 md:col-span-2 md:col-start-1 md:mt-12", // 9 – small square
                    "col-span-12 md:col-span-2 md:col-start-4 md:mt-40", // 10 – small portrait
                    "col-span-12 md:col-span-2 md:col-start-10 md:mt-40", // 11 – landscape
                ];
                // Aspect ratio per item
                const aspects = [
                    "aspect-[3/4]",
                    "aspect-[3/4]",
                    "aspect-square",
                    "aspect-square",
                    "aspect-[4/3]",
                    "aspect-[3/4]",
                    "aspect-[3/4]",
                    "aspect-[3/4]",
                    "aspect-square",
                    "aspect-square",
                    "aspect-[3/4]",
                    "aspect-[4/3]",
                ];
                const cls = positions[i] ?? positions[11];
                const aspect = aspects[i] ?? "aspect-[3/4]";
                return (
                    <div class={cls}>
                        <a
                            href={`/work/${work.slug}`}
                            class="block group relative overflow-hidden cursor-pointer"
                        >
                            <img
                                src={work.src.src}
                                alt={work.alt}
                                class={`w-full ${aspect} object-cover transition-transform duration-300 ease-out group-hover:scale-105`}
                            />
                            <div class="absolute inset-0 bg-[#f05497] opacity-0 transition-opacity duration-300 ease-out mix-blend-multiply group-hover:opacity-100" />
                        </a>
                        <p class="text-sm mt-1 text-right">{work.date}</p>
                    </div>
                );
            })
        }
    </div>
</div>

<div
    class="min-h-screen bg-[#1a0910] flex flex-col items-center justify-center py-50 px-6"
>
    <!-- Heading -->
    <h1
        class="w-full text-center font-display font-bold uppercase leading-[0.92] tracking-[-0.04em]
           text-[3rem] sm:text-[4rem] md:text-[6rem] md:max-w-[850px]
           text-[#f5f2f0] mb-30"
    >
        The Work I Do <br />
        for Clients
    </h1>

    <!-- Cards Container -->
    <div
        class="flex flex-col sm:flex-row items-center justify-center
           gap-8 sm:gap-2 md:gap-1
           py-20"
    >
        <!-- Card 1: Cuts & Styling -->
        <div
            class="group relative w-[368px] h-[432px] bg-[#26151C] p-8
         flex flex-col justify-end
         border-3 border-[#312028]
         transition-all duration-300 ease-out
         -rotate-[6deg]
         shadow-2xl cursor-pointer"
        >
            <!-- Icon (Top Left) -->
            <div class="absolute top-8 left-8">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="#f05497"
                    class="w-15 h-15"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7.848 8.25l1.536.887M7.848 8.25a3 3 0 11-5.196-3 3 3 0 015.196 3zm1.536.887a2.165 2.165 0 011.083 1.839c.005.351.054.695.14 1.024M9.384 9.137l2.077 1.199M7.848 15.75l1.536-.887m-1.536.887a3 3 0 11-5.196 3 3 3 0 015.196-3zm1.536-.887a2.165 2.165 0 001.083-1.838c.005-.352.054-.695.14-1.025m-1.223 2.863l2.077-1.199m0-3.328a4.323 4.323 0 012.068-1.379l5.325-1.628a4.5 4.5 0 012.48-.044l.803.215-7.794 4.5m-2.882-1.664A4.331 4.331 0 0010.607 12m3.736 0l7.794 4.5-.802.215a4.5 4.5 0 01-2.48-.043l-5.326-1.629a4.324 4.324 0 01-2.068-1.379M14.343 12l-2.882 1.664"
                    ></path>
                </svg>
            </div>

            <!-- Text (Bottom) -->
            <div>
                <h3
                    class="font-display text-3xl font-bold uppercase text-[#f5f2f0] leading-tight mb-3"
                >
                    Cuts &amp;<br />Styling
                </h3>
                <p
                    class="font-sans text-sm text-[#a89a9e] leading-snug max-w-[220px]"
                >
                    Precision cuts and styling tailored to your lifestyle.
                </p>
            </div>
        </div>

        <!-- Card 2: Color & Highlights -->
        <div
            class="group relative w-[368px] h-[432px] bg-[#26151C] p-8
         flex flex-col justify-end
         border-3 border-[#312028]
         transition-all duration-300 ease-out
         rotate-[3deg]
         shadow-2xl cursor-pointer z-10"
        >
            <!-- Icon (Top Left) -->
            <div class="absolute top-8 left-8">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="#f05497"
                    class="w-15 h-15"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"
                    ></path>
                </svg>
            </div>

            <!-- Text (Bottom) -->
            <div>
                <h3
                    class="font-display text-3xl font-bold uppercase text-[#f5f2f0] leading-tight mb-3"
                >
                    Color &amp;<br />Highlights
                </h3>
                <p
                    class="font-sans text-sm text-[#a89a9e] leading-snug max-w-[220px]"
                >
                    Custom color and highlights for natural depth and balance.
                </p>
            </div>
        </div>

        <!-- Card 3: Bridal & Event Hair -->
        <div
            class="group relative w-[368px] h-[432px] bg-[#26151C] p-8
         flex flex-col justify-end
         border-3 border-[#312028]
         transition-all duration-300 ease-out
         rotate-[7deg]
         shadow-2xl cursor-pointer"
        >
            <!-- Icon (Top Left) -->
            <div class="absolute top-8 left-8">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="#f05497"
                    class="w-15 h-15"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
                    ></path>
                </svg>
            </div>

            <!-- Text (Bottom) -->
            <div>
                <h3
                    class="font-display text-3xl font-bold uppercase text-[#f5f2f0] leading-tight mb-3"
                >
                    Bridal &amp;<br />Event Hair
                </h3>
                <p
                    class="font-sans text-sm text-[#a89a9e] leading-snug max-w-[220px]"
                >
                    Lasting styles for weddings and special occasions.
                </p>
            </div>
        </div>
    </div>
</div>

<div>
    <img src={spacer.src} />
</div>

<div class="w-full overflow-hidden border-y border-ink py-4">
    <div
        class="flex w-max animate-[ticker_30s_linear_infinite] items-center whitespace-nowrap"
    >
        {
            /* 1. Duplicate the array 4 times to guarantee it fills the screen */
            [...ticker, ...ticker].map((item, index) => (
                <div key={index} class="flex items-center">
                    <span class="text-sm uppercase">{item}</span>
                    <div
                        class="framer-v100r8 mx-4 h-[1px] w-15 bg-ink"
                        data-framer-name="Divider"
                    />
                </div>
            ))
        }
    </div>
</div>

<Expect />
<div
    class="relative min-h-screen bg-[#f5f2f0] flex flex-col items-center justify-center py-20 overflow-hidden"
>
    <!-- Heading -->
    <h2
        class="font-script text-4xl tracking-wide uppercase text-[#f05497] mb-16 z-20"
    >
        What Clients Say
    </h2>

    <!-- Carousel Container (Centers the cards) -->
    <div class="relative w-full flex items-center justify-center h-[500px]">
        <!-- Cards Wrapper -->
        <div class="relative w-full max-w-6xl flex items-center justify-center">
            <!-- Card 1 (Left) -->
            <div
                class="absolute w-[320px] bg-white p-8 shadow-xl transition-all duration-500 ease-out opacity-60 scale-90 -translate-x-[280px] rotate-[-4deg] z-10"
            >
                <p class="text-xs text-gray-400 mb-4">17 FEB, 2026</p>
                <p class="text-[15px] leading-relaxed text-[#1a0910] mb-20">
                    I wanted something simple and low-maintenance, and she got
                    it right immediately. My hair now feels balanced, soft, and
                    easy to manage every single day.
                </p>
                <div
                    class="flex items-end justify-between border-t border-gray-100 pt-4"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-full overflow-hidden bg-gray-200"
                        >
                            <img
                                src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80"
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-[#1a0910]">
                                Chiara Ferrari
                            </p>
                            <p
                                class="text-[10px] uppercase text-gray-500 tracking-wider"
                            >
                                Cut & Styling<br />First Visit
                            </p>
                        </div>
                    </div>
                    <div
                        class="text-sm font-semibold text-[#1a0910] flex items-center gap-1"
                    >
                        <span class="text-[#f05497]">★</span> 5.0
                    </div>
                </div>
            </div>

            <!-- Card 2 (Center - Active) -->
            <div
                class="absolute w-[360px] bg-white p-8 shadow-2xl transition-all duration-500 ease-out scale-100 z-20"
            >
                <p class="text-xs text-gray-400 mb-4">19 DEC, 2025</p>
                <p class="text-[16px] leading-relaxed text-[#1a0910] mb-30">
                    You can feel the care and attention in every step of the
                    process. The result looks effortless, and styling at home
                    has become much easier, quicker, and more natural.
                </p>
                <div
                    class="flex items-end justify-between border-t border-gray-100 pt-4"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-full overflow-hidden bg-gray-200"
                        >
                            <img
                                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80"
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-[#1a0910]">
                                Valentina Greco
                            </p>
                            <p
                                class="text-[10px] uppercase text-gray-500 tracking-wider"
                            >
                                Styling<br />First Visit
                            </p>
                        </div>
                    </div>
                    <div
                        class="text-sm font-semibold text-[#1a0910] flex items-center gap-1"
                    >
                        <span class="text-[#f05497]">★</span> 5.0
                    </div>
                </div>
            </div>

            <!-- Card 3 (Right) -->
            <div
                class="absolute w-[320px] bg-white p-8 shadow-xl transition-all duration-500 ease-out opacity-60 scale-90 translate-x-[280px] rotate-[4deg] z-10"
            >
                <p class="text-xs text-gray-400 mb-4">28 JAN, 2026</p>
                <p class="text-[15px] leading-relaxed text-[#1a0910] mb-20">
                    Sofia really understands hair. She made sure the cut feels
                    natural, and the color still looks great weeks later. Easy,
                    calm, and very professional throughout the whole experience.
                </p>
                <div
                    class="flex items-end justify-between border-t border-gray-100 pt-4"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-full overflow-hidden bg-gray-200"
                        >
                            <img
                                src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=100&auto=format&fit=crop&q=80"
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-[#1a0910]">
                                Martina Bianchi
                            </p>
                            <p
                                class="text-[10px] uppercase text-gray-500 tracking-wider"
                            >
                                Color & Highlights<br />Regular Client
                            </p>
                        </div>
                    </div>
                    <div
                        class="text-sm font-semibold text-[#1a0910] flex items-center gap-1"
                    >
                        <span class="text-[#f05497]">★</span> 4.9
                    </div>
                </div>
            </div>
        </div>
    </div>

