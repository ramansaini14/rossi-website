---
import { nav, site, socials } from "../data/site.js";
---

<footer class="bg-ink px-4 py-16 text-paper md:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-10">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <a href="/" class="font-display text-5xl font-bold uppercase tracking-display md:text-7xl" data-astro-prefetch>
        {site.name}
      </a>
      <a href={site.bookingUrl} class="label inline-flex items-center gap-2" target="_blank" rel="noreferrer">
        Book Now
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid gap-10 sm:grid-cols-3">
      <div class="flex flex-col gap-2">
        {
          nav.map((item) => (
            <a href={item.href} data-astro-prefetch class="label">
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-2">
        {
          socials.map((item) => (
            <a href={item.href} class="label" target="_blank" rel="noreferrer">
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-2">
        <a href={`tel:${site.phone}`} class="label">{site.phone}</a>
        <a href={`mailto:${site.email}`} class="label">{site.email}</a>
        <a href={site.telegram} class="label" target="_blank" rel="noreferrer">Telegram</a>
      </div>
    </div>
  </div>
</footer>
